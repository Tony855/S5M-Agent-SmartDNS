# S5M optional SmartDNS cache template
# Install SmartDNS separately and review the official syntax for your packaged version.
# This binds only to loopback: do not expose the cache to the public Internet.
bind 127.0.0.1:6053
bind-tcp 127.0.0.1:6053

# Cache behavior
cache-size 4096
prefetch-domain yes
serve-expired yes

# Encrypted DNS-over-TLS only. Literal IP endpoints avoid bootstrap loops.
# In S5M Agent, PROCESS-NAME,smartdns routes these sockets through the selected proxy.
server-tls 1.1.1.1:853 -host-name cloudflare-dns.com
server-tls 8.8.8.8:853 -host-name dns.google

# Avoid enabling audit logging unless query logs are intentionally required.
audit-enable no
