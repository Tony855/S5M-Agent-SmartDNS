#!/command/with-contenv sh
set -eu
umask 077

MIHOMO_HOME="${MIHOMO_HOME:-/data}"
CONFIG_PATH="${MIHOMO_HOME}/config.yaml"
MIHOMO_BIN="${MIHOMO_BIN:-/usr/local/bin/mihomo}"
MIHOMO_BACKUP="${MIHOMO_BIN}.previous"
DEFAULT_CONFIG_PATH="${DEFAULT_CONFIG_PATH:-/app/default-config.yaml}"
LEGACY_CONFIG_PATH="${LEGACY_CONFIG_PATH:-/data/s5m-next/config.yaml}"

# Persistent volumes are untrusted input. Reject traversal and every symlink
# component before mkdir, migration, chmod, or config writes.
case "$MIHOMO_HOME" in
  /*) ;;
  *) echo "Mihomo 数据目录必须是绝对路径" >&2; exit 1 ;;
esac
case "$MIHOMO_HOME" in
  /data) ;;
  /*/*) ;;
  *) echo "Mihomo 数据目录必须是专用子目录，拒绝系统根级目录" >&2; exit 1 ;;
esac
case "$MIHOMO_HOME" in
  /|*//*|*/./*|*/.|*/../*|*/..) echo "Mihomo 数据目录路径不安全" >&2; exit 1 ;;
esac
current=""
rest="${MIHOMO_HOME#/}"
while [ -n "$rest" ]; do
  component="${rest%%/*}"
  if [ "$rest" = "$component" ]; then rest=""; else rest="${rest#*/}"; fi
  [ -n "$component" ] && [ "$component" != "." ] && [ "$component" != ".." ] || {
    echo "Mihomo 数据目录包含不安全路径组件" >&2
    exit 1
  }
  current="$current/$component"
  [ ! -L "$current" ] || { echo "拒绝符号链接数据目录：$current" >&2; exit 1; }
  if [ -e "$current" ] && [ ! -d "$current" ]; then
    echo "Mihomo 数据目录组件不是目录：$current" >&2
    exit 1
  fi
done
mkdir -p "$MIHOMO_HOME"
[ -d "$MIHOMO_HOME" ] && [ ! -L "$MIHOMO_HOME" ] || {
  echo "Mihomo 数据目录无效" >&2
  exit 1
}
chmod 0700 "$MIHOMO_HOME"

# Never follow a volume-provided config or rollback symlink.
for path in "$CONFIG_PATH" "$CONFIG_PATH.pre-no-smartdns"; do
  [ ! -L "$path" ] || { echo "拒绝符号链接配置文件：$path" >&2; exit 1; }
done
if [ -e "$CONFIG_PATH" ] && [ ! -f "$CONFIG_PATH" ]; then
  echo "Mihomo 配置不是普通文件" >&2
  exit 1
fi
for path in "$MIHOMO_BIN" "$MIHOMO_BACKUP"; do
  [ ! -L "$path" ] || { echo "拒绝符号链接 Mihomo 内核：$path" >&2; exit 1; }
done

# Recover an interrupted kernel upgrade before services start.
if [ -e "$MIHOMO_BACKUP" ]; then
  echo "检测到未完成的 Mihomo 内核升级，尝试恢复旧内核"
  if [ -f "$MIHOMO_BACKUP" ] && [ -x "$MIHOMO_BACKUP" ]; then
    rm -f "$MIHOMO_BIN"
    mv "$MIHOMO_BACKUP" "$MIHOMO_BIN"
    chmod 0755 "$MIHOMO_BIN"
    echo "已恢复旧 Mihomo 内核"
  else
    echo "旧 Mihomo 内核备份不存在或不可执行，拒绝覆盖当前内核" >&2
    exit 1
  fi
fi

# One-time migration from the retired directory; never follow a symlink source.
LEGACY_DIR="$(dirname "$LEGACY_CONFIG_PATH")"
if [ -L "$LEGACY_DIR" ] || [ -L "$LEGACY_CONFIG_PATH" ]; then
  echo "拒绝从符号链接迁移旧 Mihomo 配置" >&2
  exit 1
fi
if [ ! -s "$CONFIG_PATH" ] && [ -s "$LEGACY_CONFIG_PATH" ]; then
  config_tmp="$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")"
  trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
  cp "$LEGACY_CONFIG_PATH" "$config_tmp"
  chmod 0600 "$config_tmp"
  mv -f "$config_tmp" "$CONFIG_PATH"
  trap - EXIT HUP INT TERM
  echo "已将旧 Mihomo 配置迁移到 $CONFIG_PATH"
fi

if [ ! -s "$CONFIG_PATH" ]; then
  config_tmp="$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")"
  trap 'rm -f "$config_tmp"' EXIT HUP INT TERM
  cp "$DEFAULT_CONFIG_PATH" "$config_tmp"
  chmod 0600 "$config_tmp"
  mv -f "$config_tmp" "$CONFIG_PATH"
  trap - EXIT HUP INT TERM
fi

[ -f "$CONFIG_PATH" ] && [ ! -L "$CONFIG_PATH" ] || {
  echo "Mihomo 配置文件无效" >&2
  exit 1
}
chmod 0600 "$CONFIG_PATH"

# Generate a persistent API secret only for known default placeholders.
if grep -Eq '^secret:[[:space:]]*"?(__S5M_GENERATED_SECRET__|__S5M_MIHOMO_SECRET__|change-this-secret)"?[[:space:]]*$' "$CONFIG_PATH"; then
  secret="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d '[:space:]')"
  [ "${#secret}" -eq 64 ] || { echo "无法生成 Mihomo API secret" >&2; exit 1; }
  sed -i "s|^secret:.*|secret: \\"$secret\\"|" "$CONFIG_PATH"
  chmod 0600 "$CONFIG_PATH"
fi

# Restore an interrupted multi-file config transaction before s6 starts
# Mihomo or SmartDNS. The old config was previously healthy; supervised
# services will start from these restored bytes after cont-init completes.
/app/s5m-agent --recover-config-transaction-before-services
