#!/command/with-contenv sh
set -eu

CONFIG_PATH="${SMARTDNS_CONFIG_PATH:-/data/smartdns.conf}"
DEFAULT_CONFIG="${SMARTDNS_DEFAULT_CONFIG:-/etc/smartdns/smartdns.conf}"
CONFIG_DIR="$(dirname "$CONFIG_PATH")"
TEMP_CONFIG=""

cleanup() {
  if [ -n "$TEMP_CONFIG" ]; then
    rm -f "$TEMP_CONFIG"
  fi
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$CONFIG_DIR"

# Never follow a volume-provided symlink or replace a directory/device node.
if [ -L "$CONFIG_PATH" ] || { [ -e "$CONFIG_PATH" ] && [ ! -f "$CONFIG_PATH" ]; }; then
  echo "SmartDNS configuration path must be a regular file, not a symlink or special file" >&2
  exit 1
fi

# Existing non-empty configurations are preserved. The only automatic edit is a
# signature-gated migration of the exact six-resolver stock profile shipped by
# earlier S5M images. It adds IPv6 peers while retaining every original IPv4
# resolver, preserving IPv4-only, IPv6-only and dual-stack compatibility.
if [ -s "$CONFIG_PATH" ]; then
  OLD_CF='server-tls 1.1.1.1:853 -host-name cloudflare-dns.com -tls-host-verify cloudflare-dns.com'
  OLD_GOOGLE='server-tls 8.8.8.8:853 -host-name dns.google -tls-host-verify dns.google'
  OLD_ALI_1='server-tls 223.5.5.5:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group'
  OLD_ALI_2='server-tls 223.6.6.6:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group'
  OLD_TENCENT_1='server-tls 1.12.12.12:853 -host-name dot.pub -tls-host-verify dot.pub -group china-dot -exclude-default-group'
  OLD_TENCENT_2='server-tls 120.53.53.53:853 -host-name dot.pub -tls-host-verify dot.pub -group china-dot -exclude-default-group'

  if grep -Fqx "$OLD_CF" "$CONFIG_PATH" &&
     grep -Fqx "$OLD_GOOGLE" "$CONFIG_PATH" &&
     grep -Fqx "$OLD_ALI_1" "$CONFIG_PATH" &&
     grep -Fqx "$OLD_ALI_2" "$CONFIG_PATH" &&
     grep -Fqx "$OLD_TENCENT_1" "$CONFIG_PATH" &&
     grep -Fqx "$OLD_TENCENT_2" "$CONFIG_PATH"; then
    umask 077
    TEMP_CONFIG="$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")"
    if ! awk \
      -v old_cf="$OLD_CF" -v new_cf='server-tls [2606:4700:4700::1111]:853 -host-name cloudflare-dns.com -tls-host-verify cloudflare-dns.com' \
      -v old_google="$OLD_GOOGLE" -v new_google='server-tls [2001:4860:4860::8888]:853 -host-name dns.google -tls-host-verify dns.google' \
      -v old_ali_1="$OLD_ALI_1" -v new_ali_1='server-tls [2400:3200::1]:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group' \
      -v old_ali_2="$OLD_ALI_2" -v new_ali_2='server-tls [2400:3200:baba::1]:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group' '
      $0 == old_cf { print; print new_cf; next }
      $0 == old_google { print; print new_google; next }
      $0 == old_ali_1 { print; print new_ali_1; next }
      $0 == old_ali_2 { print; print new_ali_2; next }
      { print }
    ' "$CONFIG_PATH" > "$TEMP_CONFIG"; then
      echo "Failed to stage the dual-stack SmartDNS upstream migration" >&2
      exit 1
    fi
    for expected in 'server-tls 1.1.1.1:853 -host-name cloudflare-dns.com -tls-host-verify cloudflare-dns.com' 'server-tls [2606:4700:4700::1111]:853 -host-name cloudflare-dns.com -tls-host-verify cloudflare-dns.com' 'server-tls 8.8.8.8:853 -host-name dns.google -tls-host-verify dns.google' 'server-tls [2001:4860:4860::8888]:853 -host-name dns.google -tls-host-verify dns.google' 'server-tls 223.5.5.5:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group' 'server-tls [2400:3200::1]:853 -host-name dns.alidns.com -tls-host-verify dns.alidns.com -group china-dot -exclude-default-group'; do
      grep -Fqx "$expected" "$TEMP_CONFIG" || {
        echo "Dual-stack SmartDNS migration output is incomplete" >&2
        exit 1
      }
    done
    chmod 0600 "$TEMP_CONFIG"
    if ! mv -f "$TEMP_CONFIG" "$CONFIG_PATH"; then
      echo "Failed to atomically install the IPv6-only SmartDNS upstream migration" >&2
      exit 1
    fi
    TEMP_CONFIG=""
    echo "Migrated the stock SmartDNS DoT profile to dual-stack upstreams"
  fi
  chmod 0600 "$CONFIG_PATH"
  exit 0
fi

# Never start with an empty or partial config if the packaged default is missing.
if [ ! -f "$DEFAULT_CONFIG" ] || [ ! -s "$DEFAULT_CONFIG" ]; then
  echo "SmartDNS default configuration is missing or empty: $DEFAULT_CONFIG" >&2
  exit 1
fi

# Create an unpredictable staging file beside the destination. Keeping it in
# the same directory guarantees that the final rename is atomic on this filesystem.
umask 077
TEMP_CONFIG="$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")"
if ! cp "$DEFAULT_CONFIG" "$TEMP_CONFIG"; then
  echo "Failed to stage the default SmartDNS configuration" >&2
  exit 1
fi
chmod 0600 "$TEMP_CONFIG"
if [ ! -s "$TEMP_CONFIG" ]; then
  echo "Staged SmartDNS configuration is empty" >&2
  exit 1
fi
if ! mv -f "$TEMP_CONFIG" "$CONFIG_PATH"; then
  echo "Failed to atomically install the default SmartDNS configuration" >&2
  exit 1
fi
TEMP_CONFIG=""

[ -s "$CONFIG_PATH" ] || {
  echo "SmartDNS configuration initialization produced an empty file" >&2
  exit 1
}
