#!/command/with-contenv sh
set -eu
# The disabled marker is persistent in /data. Keep the supervised service
# quiescent while disabled, but watch for the marker being removed by an
# enable command. This is important after container restart: s6 considers
# this waiting process "up", so a later s6-svc -u alone will not rerun it.
if [ -f /data/smartdns.disabled ]; then
  while [ -f /data/smartdns.disabled ]; do
    sleep 1
  done
fi
exec /usr/sbin/smartdns -f -x -c /data/smartdns.conf
